# dukafi-editor/ is our fork of Instatic and is tracked as part of this
# monorepo. Only its build output and dependencies are ignored.
dukafi-editor/dist/
dukafi-editor/.tmp-lint/

# Full upstream Instatic clone, kept only as a diffing/reference baseline.
# Has its own .git — never tracked as part of this repo.
/reference/instatic/

# GHCR token for ./deploy-image — never commit this
.ghcr-token

# Sidecar bundle build output
dukafi-editor/.tmp-sidecar/

# Assist shadow meter (billing off)
dukafi/tmp/
