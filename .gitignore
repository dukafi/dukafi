db/*.sqlite3
db/*.sqlite3-*
dukafi/db/*.sqlite3
dukafi/db/*.sqlite3-*
/published/
/uploads/
/public/admin/
dukafi/published/*
!dukafi/published/.keep
dukafi/uploads/*
!dukafi/uploads/.keep
dukafi/public/admin/*
!dukafi/public/admin/.keep
node_modules/
.env
dukafi/vendor/tailwindcss

# dukafi-editor/ is our fork of Instatic and is tracked as part of this
# monorepo. Only its build output and dependencies are ignored.
dukafi-editor/dist/
dukafi-editor/.tmp-lint/

# Full upstream Instatic clone, kept only as a diffing/reference baseline.
# Has its own .git — never tracked as part of this repo.
/reference/instatic/

# GHCR token for ./deploy-image — never commit this
.ghcr-token

# Sidecar bundle build output
dukafi-editor/.tmp-sidecar/

# Plugin registry (Go): local build output and its catalogue database.
# The binary is 16 MB and rebuilt by `go build`; the .sqlite3 is real data.
/registry/registry
/registry/*.sqlite3
/registry/*.sqlite3-*

# GHCR token for ./registry/deploy-registry — never commit this
registry/.ghcr-token
