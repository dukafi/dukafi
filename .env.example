# Required security
SESSION_SECRET=replace-with-at-least-64-random-characters
# Optional independent encryption key: base64 for exactly 32 bytes.
# DUKAFI_SECRET_KEY=

# Web process
PORT=9292
DB_POOL=5
RACK_ENV=production
APP_ENV=production
# DATABASE_URL=postgresql://dukafi:password@postgres:5432/dukafi
DUKAFI_DB=/data/dukafi.sqlite3

# Durable state roots
DUKAFI_STORAGE_ROOT=/data
DUKAFI_PUBLISHED_ROOT=/data/published
DUKAFI_PLUGINS_ROOT=/data/plugins
DUKAFI_PUBLISHED_STORE=disk

# Registry and optional Dukafi AI harness
DUKAFI_REGISTRY_URL=https://registry.dukafi.dev
DUKAFI_PUBLIC_ORIGIN=https://shop.example.com
# DUKAFI_AI_URL=
# DUKAFI_AI_KEY=
# DUKAFI_AI_SHADOW_LOG=/data/ai-shadow.jsonl
# DUKAFI_MCP_ALLOWED_ORIGINS=https://trusted-client.example

# Process controls
DUKAFI_DISABLE_SCHEDULER=0
SKIP_MIGRATIONS=0
SKIP_SIDECAR=0
# DUKAFI_SIDECAR_URL=unix:///tmp/dukafi-sidecar.sock
# DUKAFI_SIDECAR_SOCKET=/tmp/dukafi-sidecar.sock
# DUKAFI_SIDECAR_TOKEN=generated-by-entrypoint
# TAILWINDCSS_BIN=/usr/local/bin/tailwindcss
DUKAFI_REPLICAS=2
DOMAIN=shop.example.com
DUKAFI_IMAGE=ghcr.io/dukafi/dukafi:latest

# AI keys, SMTP, payment, shipping, and storage credentials are entered as
# encrypted connection/plugin settings in Dashboard; they are not env vars.
